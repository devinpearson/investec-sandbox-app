PORT=3000
AUTH=false
CLIENT_ID=
CLIENT_SECRET=
API_KEY=
TOKEN_EXPIRY=1799
DATABASE_URL="file:./dev.db"
# Where the dashboard and OAuth login/consent pages run (the web/ app)
WEB_URL=http://localhost:3001
# Sign-in and /identity requests allowed per minute per IP (default 300)
AUTH_RATE_LIMIT=300
# Exchange rates: the ECB's reference rates from https://frankfurter.dev, fetched
# at startup and every six hours. off = never fetch (use the stored rates).
# REFERENCE_RATES=off
